{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "types": ["node", "vitest", "vscode"],
    "paths": {
      "@arc/contracts": ["packages/contracts/src/index.ts"],
      "@arc/shared": ["packages/shared/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
