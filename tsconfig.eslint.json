{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["node", "vitest", "vscode"],
    "paths": {
      "@arc/contracts": ["packages/contracts/src/index.ts"],
      "@arc/shared": ["packages/shared/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
