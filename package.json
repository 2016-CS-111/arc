{
  "name": "arc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "backend:build": "pnpm --filter @arc/ai-server... build",
    "backend:dev": "pnpm --filter @arc/ai-server dev",
    "backend:start": "pnpm --filter @arc/ai-server start",
    "build": "tsc -b",
    "clean": "pnpm -r exec rm -rf dist",
    "dev:server": "pnpm backend:dev",
    "extension:build": "pnpm --filter arc-vscode-extension build",
    "extension:dev": "pnpm --filter arc-vscode-extension dev",
    "extension:host": "node scripts/run-extension-host.mjs",
    "extension:run": "pnpm extension:host",
    "extension:watch": "pnpm --filter arc-vscode-extension watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"apps/**/*.ts\" \"packages/**/*.ts\" --max-warnings=0",
    "ollama:smoke": "pnpm --filter @arc/ai-server ollama:smoke",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.13",
    "@types/vscode": "^1.101.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.6.2",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.4"
  }
}
