ARC_SERVER_HOST=127.0.0.1
ARC_SERVER_PORT=7331
ARC_CORS_ORIGIN=*

# PostgreSQL is required for durable sessions from Milestone 2.5 onward.
ARC_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/arc
ARC_DATABASE_CONNECT_TIMEOUT_MS=5000
# Set true only for local model-table bootstrap. Migrations remain the schema authority.
ARC_DATABASE_SYNC=true

# Bounded metadata-only repository inventory.
ARC_PROJECT_SCAN_MAX_FILES=20000
ARC_PROJECT_SCAN_MAX_TOTAL_BYTES=2147483648
ARC_PROJECT_SCAN_MAX_DEPTH=32
ARC_PROJECT_SCAN_BATCH_SIZE=500
ARC_PROJECT_SOURCE_MAX_FILE_BYTES=1048576
ARC_PROJECT_SOURCE_MAX_TOTAL_BYTES=268435456
ARC_PROJECT_SOURCE_BATCH_SIZE=500

# Choose one of the Qwen Coder models installed locally.
ARC_OLLAMA_BASE_URL=http://127.0.0.1:11434
ARC_OLLAMA_MODEL=qwen2.5-coder:7b
ARC_OLLAMA_REQUEST_TIMEOUT_MS=300000
ARC_OLLAMA_READINESS_TIMEOUT_MS=5000
