ARC_SERVER_HOST=127.0.0.1
ARC_SERVER_PORT=7331
ARC_CORS_ORIGIN=*

# PostgreSQL is required for durable sessions from Milestone 2.5 onward.
ARC_DATABASE_URL=postgresql://arc:arc@127.0.0.1:5433/arc
ARC_DATABASE_CONNECT_TIMEOUT_MS=5000

# Choose one of the Qwen Coder models installed locally.
ARC_OLLAMA_BASE_URL=http://127.0.0.1:11434
ARC_OLLAMA_MODEL=qwen2.5-coder:7b
ARC_OLLAMA_REQUEST_TIMEOUT_MS=300000
ARC_OLLAMA_READINESS_TIMEOUT_MS=5000
