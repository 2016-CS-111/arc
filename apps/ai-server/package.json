{
  "name": "@arc/ai-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "chat:cancel-smoke": "tsx src/cli/chat-socket-smoke.ts --cancel",
    "chat:socket-smoke": "tsx src/cli/chat-socket-smoke.ts",
    "dev": "tsx watch src/main.ts",
    "ollama:smoke": "tsx src/cli/ollama-smoke.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@arc/contracts": "workspace:*",
    "@arc/shared": "workspace:*",
    "@nestjs/common": "^11.1.28",
