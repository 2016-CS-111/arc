{
  "name": "@arc/ai-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "chat:cancel-smoke": "tsx src/cli/chat-socket-smoke.ts --cancel",
    "chat:socket-smoke": "tsx src/cli/chat-socket-smoke.ts",
    "db:create": "tsx src/cli/db-create.ts",
    "db:backup": "tsx src/cli/db-backup.ts",
    "db:migrate": "tsx src/cli/db-migrate.ts",
    "db:restore": "tsx src/cli/db-restore.ts",
    "db:verify": "tsx src/cli/db-verify.ts",
    "dependency:index:verify": "tsx src/cli/dependency-index-verify.ts",
    "dev": "tsx watch src/main.ts",
    "embedding:smoke": "tsx src/cli/embedding-smoke.ts",
    "embedding:smoke:compiled": "node dist/cli/embedding-smoke.js",
    "embedding:catalog:verify": "tsx src/cli/embedding-catalog-verify.ts",
    "embedding:catalog:verify:compiled": "node dist/cli/embedding-catalog-verify.js",
    "evaluation:verify": "tsx src/cli/evaluation-verify.ts",
    "framework-evidence:smoke": "tsx src/cli/framework-evidence-smoke.ts",
    "framework-evidence:smoke:compiled": "node dist/cli/framework-evidence-smoke.js",
    "framework:index:verify": "tsx src/cli/framework-index-verify.ts",
    "ollama:smoke": "tsx src/cli/ollama-smoke.ts",
    "pgvector:smoke": "tsx src/cli/pgvector-smoke.ts",
    "pgvector:smoke:compiled": "node dist/cli/pgvector-smoke.js",
    "project:verify": "tsx src/cli/project-inventory-verify.ts",
    "source:index:verify": "tsx src/cli/source-index-verify.ts",
    "setup:doctor": "tsx src/cli/setup-doctor.ts",
    "symbol:index:verify": "tsx src/cli/symbol-index-verify.ts",
    "module-resolution:smoke": "tsx src/cli/module-resolution-smoke.ts",
    "module-resolution:smoke:compiled": "node dist/cli/module-resolution-smoke.js",
    "tree-sitter:smoke": "tsx src/cli/tree-sitter-smoke.ts",
    "tree-sitter:smoke:compiled": "node dist/cli/tree-sitter-smoke.js",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@arc/contracts": "workspace:*",
    "@arc/shared": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "dotenv": "^17.2.0",
    "ignore": "7.0.5",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "pgvector": "^0.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.1",
    "tree-sitter": "0.21.1",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
