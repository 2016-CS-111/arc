{
  "name": "arc-vscode-extension",
  "displayName": "Arc",
  "description": "Self-hosted AI software engineer for VSCode.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "publisher": "local",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:arc.openChat",
    "onCommand:arc.indexWorkspace",
    "onCommand:arc.registerWorkspace",
    "onCommand:arc.scanWorkspace",
    "onView:arc.chat",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "dist/extension.js.map",
    "dist/webview",
    "media",
    "README.md"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arc",
          "title": "Arc",
          "icon": "media/arc.svg"
        }
      ]
    },
    "views": {
      "arc": [
        {
          "type": "webview",
          "id": "arc.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "arc.openChat",
        "title": "Arc: Open Chat",
        "category": "Arc"
      },
      {
        "command": "arc.registerWorkspace",
        "title": "Arc: Register Workspace",
        "category": "Arc"
      },
      {
        "command": "arc.scanWorkspace",
        "title": "Arc: Scan Workspace",
        "category": "Arc"
      },
      {
        "command": "arc.indexWorkspace",
        "title": "Arc: Index Workspace Intelligence",
        "category": "Arc",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "arc.planTask",
        "title": "Arc: Plan Task",
        "category": "Arc"
      },
      {
        "command": "arc.saveTaskPlan",
        "title": "Arc: Save Task Plan",
        "category": "Arc"
      },
      {
        "command": "arc.startTaskRun",
        "title": "Arc: Start Task Run",
        "category": "Arc"
      },
      {
        "command": "arc.resumeTaskRun",
        "title": "Arc: Resume Task Run",
        "category": "Arc"
      },
      {
        "command": "arc.pauseTaskRun",
        "title": "Arc: Pause Task Run",
        "category": "Arc"
      },
      {
        "command": "arc.cancelTaskRun",
        "title": "Arc: Cancel Task Run",
        "category": "Arc"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "arc.indexWorkspace",
          "when": "view == arc.chat",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Arc",
      "properties": {
        "arc.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:7331",
          "description": "URL of the local Arc AI backend server."
        },
        "arc.inlineCompletions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable local Arc inline code completions."
        },
        "arc.inlineCompletions.debounceMs": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "maximum": 1000,
          "description": "Delay before requesting a local Arc inline completion."
        },
        "arc.inlineCompletions.maxTokens": {
          "type": "number",
          "default": 128,
          "minimum": 1,
          "maximum": 256,
          "description": "Maximum tokens generated for one Arc inline completion."
        }
      }
    }
  },
  "scripts": {
    "build": "concurrently --kill-others-on-fail --success=all \"pnpm run check:host\" \"pnpm run build:host\" \"pnpm run check:webview\" \"pnpm run build:webview\"",
    "build:host": "esbuild src/extension.ts --bundle --platform=node --format=esm --external:vscode --outfile=dist/extension.js --sourcemap",
    "check:host": "tsc -p tsconfig.json --noEmit",
    "build:webview": "vite build --config vite.config.ts",
    "check:webview": "tsc -p tsconfig.webview.json",
    "dev": "pnpm run watch",
    "host": "pnpm --dir ../.. extension:host",
    "package": "vsce package --allow-missing-repository --no-dependencies --skip-license --out arc-${npm_package_version}.vsix",
    "test": "vitest run",
    "vscode:prepublish": "pnpm run build",
    "watch": "concurrently --kill-others-on-fail \"pnpm run watch:host\" \"pnpm run watch:webview\" \"pnpm run watch:webview-types\"",
    "watch:host": "tsc -watch -p tsconfig.json",
    "watch:webview": "vite build --config vite.config.ts --watch",
    "watch:webview-types": "tsc -p tsconfig.webview.json --watch"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@arc/contracts": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  }
}
