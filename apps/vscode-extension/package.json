{
  "name": "arc-vscode-extension",
  "displayName": "Arc",
  "description": "Self-hosted AI software engineer for VSCode.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "publisher": "local",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:arc.openChat",
    "onView:arc.chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arc",
          "title": "Arc",
          "icon": "media/arc.svg"
        }
      ]
    },
    "views": {
      "arc": [
        {
          "type": "webview",
          "id": "arc.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "arc.openChat",
        "title": "Arc: Open Chat",
        "category": "Arc"
      }
    ],
    "configuration": {
      "title": "Arc",
      "properties": {
        "arc.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:7331",
          "description": "URL of the local Arc AI backend server."
        }
      }
    }
  },
  "scripts": {
    "build": "concurrently --kill-others-on-fail --success=all \"pnpm run build:host\" \"pnpm run check:webview\" \"pnpm run build:webview\"",
    "build:host": "tsc -p tsconfig.json",
    "build:webview": "vite build --config vite.config.ts",
    "check:webview": "tsc -p tsconfig.webview.json",
    "dev": "pnpm run watch",
    "host": "pnpm --dir ../.. extension:host",
    "test": "vitest run",
    "watch": "concurrently --kill-others-on-fail \"pnpm run watch:host\" \"pnpm run watch:webview\" \"pnpm run watch:webview-types\"",
    "watch:host": "tsc -watch -p tsconfig.json",
    "watch:webview": "vite build --config vite.config.ts --watch",
    "watch:webview-types": "tsc -p tsconfig.webview.json --watch"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@arc/contracts": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  }
}
